# OBRIGATÓRIOS em produção: DATABASE_URL, JWT_SECRET, CRON_SECRET
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
JWT_SECRET="replace-with-a-long-random-string"
CRON_SECRET="replace-with-a-cron-secret"

# Admin seed (npm run db:seed). Em produção, os dois são obrigatórios para criar o ADMIN.
# Em desenvolvimento, se omitidos, o seed usa admin@radar.local / ChangeMeAdmin123!
ADMIN_EMAIL="admin@radar.local"
ADMIN_PASSWORD="ChangeMeAdmin123!"

# Opcional: fila BullMQ / worker. Sem isto, a coleta roda inline (run-once / admin).
REDIS_URL="rediss://default:TOKEN@HOST:6379"

# Opcional: limita a coleta pontual (crt.sh + WhoisDS NRD)
COLLECT_KEYWORDS="keto"
COLLECT_MAX_DOMAINS="8"

# Digistore24 marketplace (listMarketplaceEntries). Sem isto o coletor marca ERROR.
# DIGISTORE24_API_KEY=""

# YouTube Data API v3 (videos.list chart=mostPopular&regionCode=BR). Sem isto o coletor marca ERROR.
# A linha tem que ser YOUTUBE_API_KEY="...". Uma chave AIza sozinha no .env não carrega.
# YOUTUBE_API_KEY=""

# Re-probe WhoisDS pendentes (só landing). Worker 80 / inline 40 / cron 25 se omitido.
# REPROBE_MAX_PER_RUN="80"
# REPROBE_GAP_MS="600"
